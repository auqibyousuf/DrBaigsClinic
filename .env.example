# CMS Authentication
CMS_PASSWORD=your_password_here
CMS_AUTH_TOKEN=your_token_here

# Email Configuration
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=your_verified_email@domain.com
APPOINTMENT_EMAIL=your_appointment_email@domain.com

# Supabase Configuration (for CMS data storage on serverless hosting)
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key_here

# Direct Postgres connection string — used ONLY by `yarn db:migrate` to apply
# SUPABASE_APPOINTMENTS_SCHEMA.sql / SUPABASE_PATIENTS_SCHEMA.sql via code
# (SUPABASE_URL/SUPABASE_ANON_KEY above go through PostgREST, which can't run
# CREATE TABLE). Get it from: Supabase Dashboard → Project Settings → Database
# → Connection string → URI (fill in your DB password).
SUPABASE_DB_URL=postgresql://postgres:your_db_password@db.xxxxx.supabase.co:5432/postgres

# Link Editing (Developer Only)
# Set to 'true' to enable editing of header menu and hero section links
# Default: false (links are disabled for single-page anchor navigation)
NEXT_PUBLIC_ENABLE_LINK_EDITING=false

# Public site URL (used to build the patient "manage your appointment" link)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# WhatsApp Cloud API (Meta, direct — no BSP middleman) for appointment
# notifications and prescription PDF delivery. See WHATSAPP_SETUP.md.
# Leave unset in development — bookings still succeed, notifications are just skipped with a warning.
META_WA_TOKEN=your_meta_permanent_access_token
META_WA_PHONE_NUMBER_ID=your_meta_phone_number_id
META_WA_TEMPLATE_NAME=your_approved_template_name

# Cron secret for the daily appointments digest (/api/cron/daily-digest)
CRON_SECRET=your_cron_secret
